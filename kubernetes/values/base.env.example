# Shared StackGuard values (split server + dashboard)
#
# Default: in-cluster Postgres + official Valkey (valkey/valkey:8).
# For managed Postgres / managed Redis-compatible cache (e.g. Azure Cache for Redis):
#   set STACKGUARD_DATABASE_URL and STACKGUARD_REDIS_URL to the managed endpoints,
#   and do not apply (or remove) the postgres/ and valkey/ manifests.

STACKGUARD_NAMESPACE=stackguard

STACKGUARD_API_URL=http://localhost:8080
STACKGUARD_DASHBOARD_URL=http://localhost:4000

STACKGUARD_SECRET=0123456789abcdef0123456789abcdef
POSTGRES_DB=stackguard
POSTGRES_USER=stackguard
POSTGRES_PASSWORD=replace-with-strong-password
STACKGUARD_DATABASE_URL=postgresql://stackguard:replace-with-strong-password@stackguard-postgres:5432/stackguard?sslmode=disable

VALKEY_USER=stackguard
VALKEY_PASSWORD=replace-with-strong-password
STACKGUARD_REDIS_URL=redis://stackguard:replace-with-strong-password@stackguard-valkey:6379/0

SERVER_IMAGE=public.ecr.aws/stackguard-io/server:v1.1.1
DASHBOARD_IMAGE=public.ecr.aws/stackguard-io/dashboard:v1.1.1
# Official Valkey image: https://hub.docker.com/r/valkey/valkey
VALKEY_IMAGE=valkey/valkey:8.1.12
# Upgrading from Postgres 16 data? Keep postgres:16.16 or migrate first.
POSTGRES_IMAGE=postgres:17.12

SERVER_SERVICE_TYPE=LoadBalancer
DASHBOARD_SERVICE_TYPE=LoadBalancer

SERVER_REQ_CPU=2
SERVER_REQ_MEM=4Gi
SERVER_LIMIT_CPU=2
SERVER_LIMIT_MEM=4Gi

DASHBOARD_REQ_CPU=1
DASHBOARD_REQ_MEM=2Gi
DASHBOARD_LIMIT_CPU=1
DASHBOARD_LIMIT_MEM=2Gi

POSTGRES_REQ_CPU=2
POSTGRES_REQ_MEM=4Gi
POSTGRES_LIMIT_CPU=2
POSTGRES_LIMIT_MEM=4Gi

VALKEY_REQ_CPU=1
VALKEY_REQ_MEM=2Gi
VALKEY_LIMIT_CPU=1
VALKEY_LIMIT_MEM=2Gi

SERVER_DATA_SIZE=10Gi
POSTGRES_STORAGE_SIZE=10Gi
VALKEY_STORAGE_SIZE=2Gi
