# Copy to values.local.yaml and customize. Never commit values.local.yaml.

secrets:
  stackguardSecret: "0123456789abcdef0123456789abcdef"  # openssl rand -hex 16
  postgres:
    password: replace-with-strong-password              # openssl rand -hex 16
  valkey:
    password: replace-with-strong-password              # openssl rand -hex 16

urls:
  dashboard: http://localhost:4000
  api: http://localhost:8080

# Default pod sizes (8 vCPU / 16 GiB node): server 2/4Gi, dashboard 1/2Gi,
# postgres 2/4Gi, valkey 1/2Gi.
# Official Valkey image is images.valkey → valkey/valkey:8

# --- Option A: bundled Postgres + Valkey (default) ---
# postgres.enabled: true
# valkey.enabled: true

# --- Option B: managed Postgres + managed Redis-compatible cache ---
# (e.g. Azure Database for PostgreSQL + Azure Cache for Redis)
# postgres:
#   enabled: false
# valkey:
#   enabled: false
# secrets:
#   databaseUrl: postgresql://user:pass@my-flexible-server.postgres.database.azure.com:5432/stackguard?sslmode=require
#   redisUrl: rediss://:accesskey@my-cache.redis.cache.windows.net:6380/0

# Pin image tags for production
# images:
#   server:
#     tag: "v1.1.1"
#   dashboard:
#     tag: "v1.1.1"
#   valkey:
#     repository: valkey/valkey
#     tag: "8"
