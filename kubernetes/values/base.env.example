# Shared Stackguard values (cloud-agnostic)
# Copy to stackguard.env and customize.

STACKGUARD_NAMESPACE=stackguard

# Public URLs (update after LoadBalancer IPs are assigned)
STACKGUARD_DASHBOARD_URL=http://localhost:4000
STACKGUARD_API_URL=http://localhost:8080
STACKGUARD_AI_URL=http://localhost:8000

# Secrets / DB
# STACKGUARD_SECRET must be EXACTLY 32 characters. Generate with: openssl rand -hex 16
STACKGUARD_SECRET=0123456789abcdef0123456789abcdef
POSTGRES_DB=stackguard
POSTGRES_USER=stackguard
POSTGRES_PASSWORD=replace-with-strong-password
STACKGUARD_DATABASE_URL=postgresql://stackguard:replace-with-strong-password@stackguard-postgres:5432/stackguard?sslmode=disable

# Images
DASHBOARD_IMAGE=public.ecr.aws/stackguard-io/dashboard:latest
AI_IMAGE=public.ecr.aws/stackguard-io/ai:latest
SERVER_IMAGE=public.ecr.aws/stackguard-io/server:latest
POSTGRES_IMAGE=postgres:16

# Service types
DASHBOARD_SERVICE_TYPE=LoadBalancer
AI_SERVICE_TYPE=LoadBalancer
SERVER_SERVICE_TYPE=LoadBalancer

# Resources - Dashboard (app): 2 vCPU, 4 GiB
DASHBOARD_REQ_CPU=2
DASHBOARD_REQ_MEM=4Gi
DASHBOARD_LIMIT_CPU=2
DASHBOARD_LIMIT_MEM=4Gi

# Resources - AI: 2 vCPU, 4 GiB
AI_REQ_CPU=2
AI_REQ_MEM=4Gi
AI_LIMIT_CPU=2
AI_LIMIT_MEM=4Gi

# Resources - Server: 4 vCPU, 8 GiB
SERVER_REQ_CPU=4
SERVER_REQ_MEM=8Gi
SERVER_LIMIT_CPU=4
SERVER_LIMIT_MEM=8Gi

# Resources - Postgres: 2 vCPU, 4 GiB
POSTGRES_REQ_CPU=2
POSTGRES_REQ_MEM=4Gi
POSTGRES_LIMIT_CPU=2
POSTGRES_LIMIT_MEM=4Gi

# Persistent storage (10 GiB per workload; storage class from cloud overlay)
DASHBOARD_DATA_SIZE=10Gi
AI_DATA_SIZE=10Gi
SERVER_DATA_SIZE=10Gi
POSTGRES_STORAGE_SIZE=10Gi

# Vertical scaling only (Off | Initial | Auto). No HPA is included.
VPA_UPDATE_MODE=Off
