# Shared StackGuard values (cloud-agnostic)
# Copy to stackguard.env and customize.

STACKGUARD_NAMESPACE=stackguard

# Public URL people open (API + UI on port 8080). Update after the LoadBalancer IP is assigned.
STACKGUARD_APPLICATION_URL=http://localhost:8080

# Secrets / DB
# STACKGUARD_SECRET must be EXACTLY 32 characters. Generate with: openssl rand -hex 16
STACKGUARD_SECRET=0123456789abcdef0123456789abcdef
POSTGRES_DB=stackguard
POSTGRES_USER=stackguard
POSTGRES_PASSWORD=replace-with-strong-password
STACKGUARD_DATABASE_URL=postgresql://stackguard:replace-with-strong-password@stackguard-postgres:5432/stackguard?sslmode=disable

# Images
APPLICATION_IMAGE=public.ecr.aws/stackguard-io/stackguard:v1.0.0
POSTGRES_IMAGE=postgres:17

# Service types
APPLICATION_SERVICE_TYPE=LoadBalancer

# Resources - Application (API + UI): 4 vCPU, 8 GiB
APPLICATION_REQ_CPU=4
APPLICATION_REQ_MEM=8Gi
APPLICATION_LIMIT_CPU=4
APPLICATION_LIMIT_MEM=8Gi

# Resources - Postgres: 2 vCPU, 4 GiB (fits one 8 vCPU / 16 GiB node with the app)
POSTGRES_REQ_CPU=2
POSTGRES_REQ_MEM=4Gi
POSTGRES_LIMIT_CPU=2
POSTGRES_LIMIT_MEM=4Gi


# Persistent storage
APPLICATION_DATA_SIZE=10Gi
POSTGRES_STORAGE_SIZE=10Gi

# No autoscaling. Application and Postgres stay at 1 pod.
# Raise APPLICATION_* / POSTGRES_* CPU and memory, and increase the node size in Terraform.
