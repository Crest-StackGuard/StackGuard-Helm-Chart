# Copy to values.local.yaml and customize. Never commit values.local.yaml.

secrets:
  stackguardSecret: "0123456789abcdef0123456789abcdef"  # openssl rand -hex 16
  postgres:
    password: replace-with-strong-password              # openssl rand -hex 16

# Optional: set explicitly instead of auto-building from postgres settings
# secrets:
#   databaseUrl: postgresql://stackguard:<password>@stackguard-postgres:5432/stackguard?sslmode=disable

urls:
  # Public address people open (API + UI on the same port).
  application: http://localhost:8080

# Marketplace / sizing (optional). Same knobs as values.marketplace.yaml.example
# application:
#   resources:
#     requests: { cpu: "4", memory: 8Gi }
#     limits:   { cpu: "4", memory: 8Gi }
#   persistence:
#     size: 10Gi

# Pin the application tag for production
# images:
#   application:
#     tag: "2.0.0"

