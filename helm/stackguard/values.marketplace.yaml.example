# Sizing overrides that map to the "App CPU / RAM / disk" choices.
# Use with: -f values-aks.yaml -f values.marketplace.yaml
#
# Node VM size is AKS Terraform node_vm_size (or the Marketplace ARM vmSize) — not a Helm value.
#
# NEVER expose / set:
#   - *.replicas (forbidden — always 1)
#   - subscription ID / cloud id (IMDS only)
#   - vmEnableAutoScale / HPA / node count

server:
  resources:
    requests:
      cpu: "2"      # UI: App CPU
      memory: 4Gi   # UI: App RAM
    limits:
      cpu: "2"      # keep equal to requests
      memory: 4Gi
  persistence:
    size: 10Gi      # UI: App disk
