{
    "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
    "handler": "Microsoft.Azure.CreateUIDef",
    "version": "0.1.2-preview",
    "parameters": {
        "config": {
            "isWizard": false,
            "basics": {
                "location": {
                    "visible": "[basics('createNewCluster')]"
                },
                "resourceGroup": {
                    "allowExisting": true
                }
            }
        },
        "basics": [
            {
                "name": "createNewCluster",
                "type": "Microsoft.Common.OptionsGroup",
                "label": "Create a new AKS cluster?",
                "defaultValue": "No",
                "toolTip": "Choose 'Yes' to provision a new AKS cluster for Stackguard, or 'No' to install into an existing cluster in this resource group.",
                "constraints": {
                    "allowedValues": [
                        {
                            "label": "Yes",
                            "value": true
                        },
                        {
                            "label": "No",
                            "value": false
                        }
                    ],
                    "required": true
                },
                "visible": true
            }
        ],
        "steps": [
            {
                "name": "clusterDetails",
                "label": "Cluster",
                "elements": [
                    {
                        "name": "existingClusterSection",
                        "type": "Microsoft.Common.Section",
                        "label": "Existing cluster",
                        "elements": [
                            {
                                "name": "clusterLookupControl",
                                "type": "Microsoft.Solutions.ArmApiControl",
                                "request": {
                                    "method": "GET",
                                    "path": "[concat(subscription().id, '/resourcegroups/', resourceGroup().name, '/providers/Microsoft.ContainerService/managedClusters?api-version=2024-09-01')]"
                                }
                            },
                            {
                                "name": "existingClusterResourceName",
                                "type": "Microsoft.Common.DropDown",
                                "label": "AKS cluster name",
                                "toolTip": "AKS cluster in the selected resource group where Stackguard is installed.",
                                "constraints": {
                                    "allowedValues": "[map(steps('clusterDetails').existingClusterSection.clusterLookupControl.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                                    "required": true
                                }
                            }
                        ],
                        "visible": "[equals(basics('createNewCluster'), false)]"
                    },
                    {
                        "name": "newClusterSection",
                        "type": "Microsoft.Common.Section",
                        "label": "New cluster",
                        "elements": [
                            {
                                "name": "aksVersionLookupControl",
                                "type": "Microsoft.Solutions.ArmApiControl",
                                "request": {
                                    "method": "GET",
                                    "path": "[concat(subscription().id, '/providers/Microsoft.ContainerService/locations/', location(), '/orchestrators?api-version=2019-04-01&resource-type=managedClusters')]"
                                }
                            },
                            {
                                "name": "newClusterResourceName",
                                "type": "Microsoft.Common.TextBox",
                                "label": "AKS cluster name",
                                "defaultValue": "",
                                "toolTip": "Only alphanumeric characters are allowed, and the value must be 6-30 characters long.",
                                "constraints": {
                                    "required": true,
                                    "regex": "^[a-z0-9A-Z]{6,30}$",
                                    "validationMessage": "Only alphanumeric characters are allowed, and the value must be 6-30 characters long."
                                }
                            },
                            {
                                "name": "kubernetesVersion",
                                "type": "Microsoft.Common.DropDown",
                                "label": "Kubernetes version",
                                "toolTip": "The Kubernetes version used for the new cluster.",
                                "constraints": {
                                    "allowedValues": "[map(steps('clusterDetails').newClusterSection.aksVersionLookupControl.properties.orchestrators, (item) => parse(concat('{\"label\":\"', item.orchestratorVersion, '\",\"value\":\"', item.orchestratorVersion, '\"}')))]",
                                    "required": true
                                }
                            },
                            {
                                "name": "vmSize",
                                "type": "Microsoft.Compute.SizeSelector",
                                "label": "VM size",
                                "toolTip": "Stackguard requests roughly 10 vCPU and 20 GiB of memory in total, so pick a size with adequate capacity.",
                                "recommendedSizes": [
                                    "Standard_D8s_v5",
                                    "Standard_D16s_v5"
                                ],
                                "constraints": {
                                    "allowedSizes": [
                                        "Standard_D8s_v5",
                                        "Standard_D16s_v5",
                                        "Standard_D8s_v4",
                                        "Standard_D16s_v4"
                                    ],
                                    "excludedSizes": []
                                },
                                "osPlatform": "Linux"
                            },
                            {
                                "name": "osSKU",
                                "type": "Microsoft.Common.DropDown",
                                "label": "OS SKU",
                                "defaultValue": "AzureLinux",
                                "toolTip": "Linux OS SKU for the node pool.",
                                "constraints": {
                                    "allowedValues": [
                                        {
                                            "label": "AzureLinux",
                                            "value": "AzureLinux"
                                        },
                                        {
                                            "label": "Ubuntu",
                                            "value": "Ubuntu"
                                        }
                                    ],
                                    "required": true
                                }
                            },
                            {
                                "name": "enableAutoScaling",
                                "type": "Microsoft.Common.CheckBox",
                                "label": "Enable auto scaling",
                                "toolTip": "Enable cluster autoscaler on the node pool.",
                                "defaultValue": true
                            },
                            {
                                "name": "vmCount",
                                "type": "Microsoft.Common.Slider",
                                "min": 1,
                                "max": 10,
                                "label": "Node count",
                                "subLabel": "",
                                "defaultValue": 3,
                                "showStepMarkers": false,
                                "toolTip": "Number of nodes in the system node pool.",
                                "constraints": {
                                    "required": false
                                },
                                "visible": true
                            }
                        ],
                        "visible": "[basics('createNewCluster')]"
                    }
                ]
            },
            {
                "name": "applicationDetails",
                "label": "Stackguard",
                "elements": [
                    {
                        "name": "extensionResourceName",
                        "type": "Microsoft.Common.TextBox",
                        "label": "Cluster extension resource name",
                        "defaultValue": "stackguard",
                        "toolTip": "Only lowercase alphanumeric characters are allowed, and the value must be 6-30 characters long.",
                        "constraints": {
                            "required": true,
                            "regex": "^[a-z0-9]{6,30}$",
                            "validationMessage": "Only lowercase alphanumeric characters are allowed, and the value must be 6-30 characters long."
                        },
                        "visible": true
                    },
                    {
                        "name": "storageClass",
                        "type": "Microsoft.Common.DropDown",
                        "label": "Storage class",
                        "defaultValue": "managed-csi",
                        "toolTip": "Storage class used for the dashboard, server, and PostgreSQL volumes.",
                        "constraints": {
                            "allowedValues": [
                                {
                                    "label": "managed-csi",
                                    "value": "managed-csi"
                                },
                                {
                                    "label": "managed-csi-premium",
                                    "value": "managed-csi-premium"
                                },
                                {
                                    "label": "default",
                                    "value": "default"
                                }
                            ],
                            "required": true
                        }
                    },
                    {
                        "name": "serviceType",
                        "type": "Microsoft.Common.DropDown",
                        "label": "Service exposure",
                        "defaultValue": "LoadBalancer",
                        "toolTip": "LoadBalancer publishes public IPs for the dashboard and API services. ClusterIP keeps them internal.",
                        "constraints": {
                            "allowedValues": [
                                {
                                    "label": "LoadBalancer",
                                    "value": "LoadBalancer"
                                },
                                {
                                    "label": "ClusterIP",
                                    "value": "ClusterIP"
                                }
                            ],
                            "required": true
                        }
                    },
                    {
                        "name": "stackguardSecret",
                        "type": "Microsoft.Common.PasswordBox",
                        "label": {
                            "password": "Stackguard secret",
                            "confirmPassword": "Confirm secret"
                        },
                        "toolTip": "Application secret. Must be exactly 32 characters. Generate with: openssl rand -hex 16",
                        "constraints": {
                            "required": true,
                            "regex": "^[a-zA-Z0-9]{32}$",
                            "validationMessage": "The secret must be exactly 32 alphanumeric characters."
                        },
                        "options": {
                            "hideConfirmation": false
                        },
                        "visible": true
                    },
                    {
                        "name": "postgresPassword",
                        "type": "Microsoft.Common.PasswordBox",
                        "label": {
                            "password": "PostgreSQL password",
                            "confirmPassword": "Confirm password"
                        },
                        "toolTip": "Password for the bundled PostgreSQL database.",
                        "constraints": {
                            "required": true,
                            "regex": "^[a-zA-Z0-9!@#$%^&*()_+\\-=]{12,64}$",
                            "validationMessage": "The password must be 12-64 characters long."
                        },
                        "options": {
                            "hideConfirmation": false
                        },
                        "visible": true
                    },
                    {
                        "name": "endpointsInfo",
                        "type": "Microsoft.Common.InfoBox",
                        "visible": true,
                        "options": {
                            "icon": "Info",
                            "text": "Leave the URLs below at their defaults for a first install. After the LoadBalancer IPs are assigned, update the extension configuration with the public endpoints."
                        }
                    },
                    {
                        "name": "dashboardUrl",
                        "type": "Microsoft.Common.TextBox",
                        "label": "Dashboard URL",
                        "defaultValue": "http://localhost:4000",
                        "toolTip": "Public URL of the Stackguard dashboard.",
                        "constraints": {
                            "required": true,
                            "regex": "^https?://.{1,200}$",
                            "validationMessage": "Enter a valid http or https URL."
                        }
                    },
                    {
                        "name": "apiUrl",
                        "type": "Microsoft.Common.TextBox",
                        "label": "API URL",
                        "defaultValue": "http://localhost:8080",
                        "toolTip": "Public URL of the Stackguard API server.",
                        "constraints": {
                            "required": true,
                            "regex": "^https?://.{1,200}$",
                            "validationMessage": "Enter a valid http or https URL."
                        }
                    }
                ]
            }
        ],
        "outputs": {
            "location": "[location()]",
            "createNewCluster": "[basics('createNewCluster')]",
            "clusterResourceName": "[if(basics('createNewCluster'), steps('clusterDetails').newClusterSection.newClusterResourceName, steps('clusterDetails').existingClusterSection.existingClusterResourceName)]",
            "kubernetesVersion": "[steps('clusterDetails').newClusterSection.kubernetesVersion]",
            "extensionResourceName": "[steps('applicationDetails').extensionResourceName]",
            "vmSize": "[steps('clusterDetails').newClusterSection.vmSize]",
            "osSKU": "[steps('clusterDetails').newClusterSection.osSKU]",
            "vmEnableAutoScale": "[steps('clusterDetails').newClusterSection.enableAutoScaling]",
            "vmCount": "[steps('clusterDetails').newClusterSection.vmCount]",
            "app-storageClass": "[steps('applicationDetails').storageClass]",
            "app-serviceType": "[steps('applicationDetails').serviceType]",
            "app-stackguardSecret": "[steps('applicationDetails').stackguardSecret]",
            "app-postgresPassword": "[steps('applicationDetails').postgresPassword]",
            "app-dashboardUrl": "[steps('applicationDetails').dashboardUrl]",
            "app-apiUrl": "[steps('applicationDetails').apiUrl]"
        }
    }
}
